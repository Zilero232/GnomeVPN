# Copy to .env at the repo root. The server validates its half at boot
# (apps/server/src/config/env.schema.ts) and refuses to start on a bad value.

NODE_ENV=development
PORT=4000

# --- Client ---
# Baked into the bundle and visible to users. No secrets.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Database ---
# 5433, not 5432: a native Postgres service usually holds 5432.
DATABASE_URL=postgresql://gnomevpn:gnomevpn@localhost:5433/gnomevpn
# Migrations only, bypassing the pooler. Differs from the above in production.
DIRECT_URL=postgresql://gnomevpn:gnomevpn@localhost:5433/gnomevpn

# --- Auth ---
# 32+ chars. Production: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-secret-change-me-min-32-chars-000
API_URL=http://localhost:4000
# Comma-separated, no spaces.
CORS_ORIGINS=http://localhost:3000

# --- YooKassa ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/account
YOOKASSA_RETURN_URL_DESKTOP=gnomevpn://account
# Enabled by YooKassa support on request. False means one-off payments.
YOOKASSA_RECURRING=false

# --- Mail ---
# Empty means no mail is sent; sign-up and sign-in still work.
# EMAIL_FROM must match SMTP_USER or the provider rejects the message.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=GnomeVPN <noreply@gnomevpn.ru>
CLIENT_URL=http://localhost:3000
# Development only: redirects every email here.
# DEV_EMAIL_OVERRIDE=you@example.com

# --- Provisioning ---
# Empty HOST means provisioning runs locally. Deploy uses DEPLOY_SSH_* secrets instead.
PROVISION_SSH_HOST=
PROVISION_SSH_USER=root
PROVISION_SSH_PASSWORD=
PROVISION_DEPLOY_PATH=/opt/gnomevpn

# Fine-grained PAT with Contents: Read. The server proxies desktop updates with it.
GITHUB_TOKEN=
