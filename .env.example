# Единый .env монорепы. Скопируй в корневой .env и подставь свои значения:
#   cp .env.example .env
# .env в git не попадает, .env.example — попадает.
#
# Сервер читает этот файл (bun --env-file .env) и валидирует свою часть Zod-схемой
# при старте (apps/server/src/config/env.schema.ts) — не поднимется с плохим значением.
# Клиент читает NEXT_PUBLIC_* через apps/client/next.config.ts, который грузит этот
# файл из корня репозитория.

# development | production | test. В development Prisma логирует warn/error.
NODE_ENV=development

# Порт HTTP-сервера.
PORT=4000

# --- Клиент (Next.js) ---
# NEXT_PUBLIC_* вшивается в бандл и видно пользователю — секретов здесь быть не должно.
# В релизных сборках значение приходит из секрета NEXT_PUBLIC_API_URL в Actions.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Пул-соединение для приложения (Prisma + better-auth).
# Локально поднимается через `bun run dev:infra` (docker-compose.dev.yml).
# Порт 5433, а не 5432: 5432 часто занят нативной службой Postgres на хосте.
DATABASE_URL=postgresql://gnomevpn:gnomevpn@localhost:5433/gnomevpn

# Прямое соединение для миграций (prisma migrate/db push), в обход пулера.
# Локально совпадает с DATABASE_URL; в проде с PgBouncer/Neon — отличается.
DIRECT_URL=postgresql://gnomevpn:gnomevpn@localhost:5433/gnomevpn

# Секрет подписи сессий better-auth. Минимум 32 символа.
# Для прода сгенерируй свой: `openssl rand -base64 32`. Никогда не переиспользуй dev-значение.
BETTER_AUTH_SECRET=dev-secret-change-me-min-32-chars-000

# Публичный адрес самого backend'а — better-auth строит по нему ссылки и куки.
API_URL=http://localhost:4000

# Origin'ы, которым разрешён CORS. Список через запятую, без пробелов.
# 3000 — Next.js dev-сервер; в Tauri-сборке фронт грузится с tauri://localhost.
CORS_ORIGINS=http://localhost:3000

# --- ЮKassa ---
# Тестовый магазин: личный кабинет ЮKassa -> «Тестовый магазин».
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/account
YOOKASSA_RETURN_URL_DESKTOP=gnomevpn://account
# Автосписания ЮKassa подключает вручную по заявке в поддержку. При false —
# разовый платёж без автопродления.
YOOKASSA_RECURRING=false
# Цены и сроки тарифов живут в packages/schemas (PLANS), не в переменных окружения.

# Ключи VPN-узлов сюда не пишутся: `bun provision` кладёт их в .env.nodes в корне.

# --- Почта (SMTP) ---
# Нужна для подтверждения адреса, смены почты и сброса пароля. Пока пусто —
# письма не отправляются, регистрация и вход работают.
#   Timeweb:  SMTP_HOST=smtp.timeweb.ru   SMTP_PORT=465  SMTP_SECURE=true
# Адрес в EMAIL_FROM должен совпадать с SMTP_USER, иначе провайдер отклонит.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=GnomeVPN <noreply@gnomevpn.ru>

# Куда ведут ссылки из писем — адрес веб-клиента.
CLIENT_URL=http://localhost:3000

# Только для разработки: все письма уходят на этот адрес вместо реального.
# DEV_EMAIL_OVERRIDE=you@example.com

# Control-VPS для `bun run provision:nodes` — тот же хост, куда deploy.yml кладёт
# docker-compose.yml. Пустой HOST/PASSWORD — провижининг локальный.
# Деплою эти значения не нужны: он берёт их из секретов DEPLOY_SSH_*.
PROVISION_SSH_HOST=
PROVISION_SSH_USER=root
PROVISION_SSH_PASSWORD=
PROVISION_DEPLOY_PATH=/opt/gnomevpn

# Нужен серверу в рантайме: он проксирует обновления десктопа с GitHub Releases.
# Достаточно fine-grained PAT с Contents: Read. Релиз и деплой свои токены берут
# из Actions, сюда их класть не нужно.
GITHUB_TOKEN=
