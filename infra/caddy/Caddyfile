# GnomeVPN — Caddy config (runs on the VPS).
#
# Certificates come from Let's Encrypt over HTTP-01, so behind Cloudflare the
# orange cloud stays off until they exist, then SSL mode must be Full (strict)
# or the two redirect each other in a loop.

(proxy_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

(access_log) {
	log {
		output stdout
		format console
	}
}

www.gnome-vpn.com {
	redir https://gnome-vpn.com{uri} permanent
}

api.gnome-vpn.com {
	encode gzip zstd

	reverse_proxy server:4000

	import access_log
}

# Callback host for Telegram, proxied through Cloudflare: our own IPv4 is blocked.
bot.gnome-vpn.com {
	# route keeps source order; without it Caddy sorts respond ahead of the proxy.
	route {
		reverse_proxy /telegram/* server:4000
		respond 404
	}

	import access_log
}

gnome-vpn.com {
	encode gzip zstd

	reverse_proxy web:3000

	# Hashed assets never change under the same name.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	import proxy_headers
	import access_log
}
