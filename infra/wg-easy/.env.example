# Скопируй в infra/wg-easy/.env на том VPS, где поднимаешь узел:
#   cp .env.example .env
# Один узел = одна страна. Подробности и проверка — в README.md.

# Публичный адрес ЭТОГО VPS (IP или домен). Именно он попадёт клиенту
# как endpoint WireGuard, поэтому 127.0.0.1 годится только для локальной проверки.
WG_HOST=203.0.113.10

# bcrypt-хеш пароля REST-панели. Сгенерировать:
#   docker run --rm ghcr.io/wg-easy/wg-easy:14 \
#     node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'ВАШ_ПАРОЛЬ' \
#     | sed 's/\$/$$/g'
#
# ВНИМАНИЕ: каждый '$' обязан быть удвоен ('$$'), иначе docker compose раскроет
# куски хеша как переменные и в контейнер приедет обрезанный хеш — все REST-запросы
# будут падать. Проверить: docker exec gnomevpn-wg-easy printenv PASSWORD_HASH
WG_EASY_PASSWORD_HASH=$$2a$$12$$replace.me.with.a.real.bcrypt.hash
