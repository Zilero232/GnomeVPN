{
  "name": "@gnomevpn/tauri",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "tauri": "tauri",
    "icon": "tauri icon icon.manifest.json -o icons",
    "predev": "bun run kill && node ./scripts/sync-wintun.mjs && node ./scripts/build-service.mjs && bun run icon",
    "dev": "tauri dev",
    "prebuild": "node ./scripts/sync-wintun.mjs && node ./scripts/build-service.mjs --release && bun run icon",
    "build": "tauri build",
    "service:build": "node ./scripts/build-service.mjs",
    "signer:sign": "tauri signer sign",
    "signer:generate": "tauri signer generate -w ~/.tauri/gnomevpn.key --ci",
    "kill": "fkill --force --silent gnomevpn.exe",
    "info": "tauri info"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
