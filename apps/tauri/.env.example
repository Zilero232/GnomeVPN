# Нужен только для локальной сборки под Android:
#   cp apps/tauri/.env.example apps/tauri/.env
# Десктопная сборка ничего отсюда не читает.

# Android SDK. Обычно ставится вместе с Android Studio:
#   Windows  %LOCALAPPDATA%\Android\Sdk
#   macOS    ~/Library/Android/sdk
#   Linux    ~/Android/Sdk
ANDROID_HOME=

# NDK — компилирует Rust под ARM. Ставится через SDK Manager
# (SDK Tools -> NDK (Side by side)); в CI берётся r27c.
# Путь всегда заканчивается версией: $ANDROID_HOME/ndk/27.2.12479018
NDK_HOME=

# JDK для Gradle. Android Studio ставит свой в jbr/, отдельно ставить не нужно:
#   Windows  C:\Program Files\Android\Android Studio\jbr
#   macOS    /Applications/Android Studio.app/Contents/jbr/Contents/Home
#   Linux    /opt/android-studio/jbr
JAVA_HOME=

# Ключ подписи здесь НЕ указывается. Локальная сборка подписывается отладочным
# ключом, который SDK создаёт сам; релизный keystore живёт только в секретах
# репозитория (ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD, ANDROID_KEY_BASE64),
# см. .github/workflows/release-app.yml. Потерянный keystore означает, что
# обновить уже установленные APK нечем — храните его вне репозитория.
