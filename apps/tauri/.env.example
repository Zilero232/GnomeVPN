# Local Android builds only. The desktop build reads nothing from here.
#   cp apps/tauri/.env.example apps/tauri/.env

# Android SDK, usually installed with Android Studio:
#   Windows  %LOCALAPPDATA%\Android\Sdk
#   macOS    ~/Library/Android/sdk
#   Linux    ~/Android/Sdk
ANDROID_HOME=

# Compiles Rust for ARM. SDK Manager -> SDK Tools -> NDK (Side by side).
# The path always ends with the version: $ANDROID_HOME/ndk/27.2.12479018
NDK_HOME=

# JDK for Gradle. Android Studio ships one in jbr/ — no separate install needed.
#   Windows  C:\Program Files\Android\Android Studio\jbr
#   macOS    /Applications/Android Studio.app/Contents/jbr/Contents/Home
#   Linux    /opt/android-studio/jbr
JAVA_HOME=

# No signing key here. Local builds use the SDK's own debug key; the release
# keystore lives only in repository secrets (ANDROID_KEY_ALIAS,
# ANDROID_KEY_PASSWORD, ANDROID_KEY_BASE64). Losing it means already-installed
# APKs can never be updated — keep it outside the repo.
