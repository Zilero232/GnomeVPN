{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GnomeVPN",
  "version": "../../package.json",
  "identifier": "app.gnomevpn.desktop",
  "build": {
    "frontendDist": "../client/out",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun --filter @gnomevpn/client build",
    "beforeDevCommand": "bun --filter @gnomevpn/client dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GnomeVPN",
        "url": "/app",
        "width": 420,
        "height": 720,
        "center": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "backgroundColor": "#070b0a",
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "resources": {
      "icons/tray/connected.png": "icons/tray/connected.png",
      "icons/tray/disconnected.png": "icons/tray/disconnected.png"
    },
    "shortDescription": "GnomeVPN desktop client",
    "longDescription": "GnomeVPN — WireGuard VPN desktop client built with Tauri 2.",
    "windows": {
      "nsis": {
        "installerHooks": "installer/hooks.nsh",
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["gnomevpn"]
      }
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3RTVCNzZCNTQ2NkVCQTkKUldTcDYyWlVhN2ZsdDVDV2puRUt2Uk5DT0xYSHh0SG9reEZ2R2VteENkZEQ2SWNQN2FJUUpISnIK",
      "endpoints": ["https://api.gnomevpn.ru/release/updater"],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
