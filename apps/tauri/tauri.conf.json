{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GnomeVPN",
  "version": "../../package.json",
  "identifier": "app.gnomevpn.desktop",
  "build": {
    "frontendDist": "../client/out",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun --filter @gnomevpn/client build",
    "beforeDevCommand": "bun --filter @gnomevpn/client dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GnomeVPN",
        "url": "/app",
        "width": 520,
        "height": 780,
        "minWidth": 520,
        "minHeight": 780,
        "center": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "backgroundColor": "#070b0a",
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "resources": {
      "icons/128x128.png": "icons/128x128.png",
      "icons/tray/connected.png": "icons/tray/connected.png",
      "icons/tray/disconnected.png": "icons/tray/disconnected.png"
    },
    "shortDescription": "GnomeVPN client",
    "longDescription": "GnomeVPN — Hysteria2 VPN client built with Tauri 2."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["gnomevpn"]
      }
    }
  }
}
