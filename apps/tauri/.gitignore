# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri (capability schemas — regenerate on build)
/gen/

# Generated from apps/client/public/brand/logo-mark.svg via `bun run icon` (see icon.manifest.json)
/icons/*
# Tray state icons are authored, not generated — `tauri icon` never writes here
!/icons/tray/

# Downloaded manually, see bin/README.md — required for the TUN device on Windows
/bin/wintun.dll

# Downloaded manually, see bin/README.md — runs the VLESS/Reality tunnel
/bin/xray.exe

# Same tunnel core built for Android, see android/README.md — 36 MB per ABI,
# fetched rather than committed for the same reason as bin/xray.exe
/android/libs/*/libxray.so

# Release signing (never commit)
*.keystore
keystore.properties

# Built by scripts/build-service.mjs — the privileged tunnel service
/bin/gnomevpn-service.exe

