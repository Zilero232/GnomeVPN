# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri (capability schemas — regenerate on build)
/gen/

# Generated from apps/client/public/brand/logo-mark.svg via `bun run icon` (see icon.manifest.json)
/icons/*
# Tray state icons are authored, not generated — `tauri icon` never writes here
!/icons/tray/

# Downloaded manually, see bin/README.md — required for the TUN device on Windows
/bin/wintun/wintun.dll

# Downloaded manually, see bin/README.md — runs the Hysteria2 tunnel
/bin/hysteria/hysteria.exe

# Downloaded manually, see bin/README.md — tunnel core with per-app routing
/bin/singbox/sing-box.exe


# Same tunnel binary built for Android, see android/README.md — per ABI,
# fetched rather than committed for the same reason as bin/hysteria/hysteria.exe
/android/libs/*/libhysteria.so

# Release signing (never commit)
*.keystore
keystore.properties

# Built by scripts/build-service.mjs — the privileged tunnel service
/bin/service/gnomevpn-service.exe

