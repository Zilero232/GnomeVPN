{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions every platform needs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "os:default",
    "process:default",
    "log:default",
    "notification:default",
    "store:default",
    "deep-link:default",

    "core:event:default",

    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",

    "core:app:allow-default-window-icon"
  ]
}
