{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Tray, updater and window chrome — desktop only",
  "windows": ["main"],
  "platforms": ["windows", "linux", "macOS"],
  "permissions": [
    "updater:default",
    "autostart:default",

    "core:tray:default",
    "core:menu:default",

    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-unminimize"
  ]
}
