# Скопируй в apps/client/.env.local и поправь при необходимости:
#   cp apps/client/.env.example apps/client/.env.local
# Валидируется Zod-схемой в shared/config/client-env.ts.
#
# Важно: всё с префиксом NEXT_PUBLIC_ вшивается в бандл и видно пользователю.
# Секретов здесь быть не должно — клиент ходит только в наш backend,
# а в панели узлов ходит исключительно backend.

# Базовый URL backend'а. Значение по умолчанию — http://localhost:4000,
# так что для локальной разработки файл можно не создавать вовсе.
# Для прод-сборки укажи публичный адрес API (например https://api.gnomevpn.ru).
#
# Android-эмулятор: localhost переписывается в 10.0.2.2 на лету, так что
# значение ниже подходит и там. На реальном телефоне localhost недостижим —
# нужен публичный адрес или адрес машины в локальной сети.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Версия, которую приложение показывает в диалоге обновления. В релизной сборке
# её подставляет CI из корневого package.json; локально можно не задавать.
NEXT_PUBLIC_APP_VERSION=0.0.0
