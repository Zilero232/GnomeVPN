# Скопируй в apps/client/.env.local и поправь при необходимости:
#   cp apps/client/.env.example apps/client/.env.local
# Валидируется Zod-схемой в shared/config/client-env.ts.
#
# Важно: всё с префиксом NEXT_PUBLIC_ вшивается в бандл и видно пользователю.
# Секретов здесь быть не должно — клиент ходит только в наш backend,
# а в wg-easy ходит исключительно backend.

# Базовый URL backend'а. Значение по умолчанию — http://localhost:4000,
# так что для локальной разработки файл можно не создавать вовсе.
# Для прод-сборки Tauri укажи публичный адрес API (например https://api.vesper.app).
NEXT_PUBLIC_API_URL=http://localhost:4000
