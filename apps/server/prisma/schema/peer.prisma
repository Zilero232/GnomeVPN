enum PeerKind {
  session
  config
}

enum TunnelProtocol {
  hysteria2
  wireguard
}

model Peer {
  id     String @id @default(dbgenerated("gen_random_uuid()"))
  userId String @map("user_id")
  nodeId String @map("node_id")

  kind     PeerKind
  protocol TunnelProtocol @default(hysteria2)
  name     String?

  nodeCredential String @map("node_credential")

  wgAssignedIp String? @map("wg_assigned_ip")

  trafficBytes BigInt    @default(0) @map("traffic_bytes")
  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, name, nodeId, protocol])
  @@unique([nodeId, wgAssignedIp])
  @@index([userId])
  @@index([kind, lastActiveAt])
  @@map("peer")
}
