enum SubscriptionPlan {
  monthly
  halfYearly
  yearly
}

model Subscription {
  id     String @id @default(dbgenerated("gen_random_uuid()"))
  userId String @unique @map("user_id")

  plan              SubscriptionPlan @default(monthly)
  currentPeriodEnd  DateTime?        @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd Boolean          @default(false) @map("cancel_at_period_end")

  extraDevices Int @default(0) @map("extra_devices")

  savedCardId      String? @map("saved_card_id")
  savedCardTitle   String? @map("saved_card_title")
  pendingCardId    String? @unique @map("pending_card_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentPeriodEnd])
  @@index([cancelAtPeriodEnd, currentPeriodEnd])
  @@map("subscription")
}
