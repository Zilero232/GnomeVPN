enum SubscriptionStatus {
  active
  expired
}

enum SubscriptionPlan {
  monthly
  halfYearly
  yearly
}

model Subscription {
  id     String             @id @default(dbgenerated("gen_random_uuid()"))
  userId String             @unique @map("user_id")
  status SubscriptionStatus @default(expired)

  plan              SubscriptionPlan @default(monthly)
  currentPeriodEnd  DateTime?        @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd Boolean          @default(false) @map("cancel_at_period_end")

  yookassaPaymentMethodId String? @map("yookassa_payment_method_id")
  paymentMethodTitle      String? @map("payment_method_title")
  pendingPaymentMethodId  String? @unique @map("pending_payment_method_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, cancelAtPeriodEnd, currentPeriodEnd])
  @@map("subscription")
}
