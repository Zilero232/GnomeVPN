model Node {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  country     String
  countryCode String  @map("country_code")
  city        String?

  host String
  port Int    @default(443)

  realityServerName String @map("reality_server_name")
  realityPublicKey  String @map("reality_public_key")
  realityShortId    String @map("reality_short_id")

  apiUrl          String @map("api_url")
  apiTokenEnvVar  String @map("api_token_env_var")

  isAvailable   Boolean   @default(true) @map("is_available")
  displayOrder  Int       @default(0) @map("display_order")
  lastHealthyAt DateTime? @map("last_healthy_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  peers Peer[]

  @@map("node")
}
