{
  "name": "@vesper/server",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "main": "src/main.ts",
  "scripts": {
    "predev": "node ./scripts/kill-port.mjs",
    "dev": "bun --hot --cwd ../.. --env-file apps/server/.env apps/server/src/main.ts",
    "start": "bun src/main.ts",
    "db:push": "prisma db push && prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "seed:node": "bun --env-file .env scripts/seed-node.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@thallesp/nestjs-better-auth": "2.7.0",
    "@vesper/schemas": "workspace:*",
    "better-auth": "^1.6.23",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "nestjs-zod": "5.4.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "remeda": "^2.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "typescript": "~6.0.3",
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "dotenv": "^17.2.0",
    "vitest": "^4.0.0"
  }
}
