{
  "name": "@gnomevpn/server",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "src/main.ts",
  "scripts": {
    "predev": "kill-port 4000",
    "dev": "bun --hot --cwd ../.. --env-file .env --env-file apps/server/.env.nodes apps/server/src/main.ts",
    "start": "bun src/main.ts",
    "db:push": "prisma db push && prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "provision": "bun --env-file ../../.env --env-file .env.nodes scripts/provision-nodes.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@gnomevpn/schemas": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.4.0",
    "@noble/curves": "^2.2.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@react-email/render": "^2.1.0",
    "@sindresorhus/slugify": "^3.0.0",
    "@thallesp/nestjs-better-auth": "2.7.0",
    "better-auth": "catalog:",
    "date-fns": "catalog:",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "nestjs-zod": "5.4.0",
    "nodemailer": "^9.0.3",
    "p-wait-for": "^6.0.0",
    "pg": "^8.13.0",
    "react": "catalog:",
    "react-email": "^6.9.1",
    "reflect-metadata": "^0.2.2",
    "remeda": "catalog:",
    "rxjs": "^7.8.1",
    "shell-quote": "^1.10.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "catalog:",
    "@types/shell-quote": "^1.7.5",
    "dotenv": "^17.2.0",
    "prisma": "^7.9.0",
    "typescript": "catalog:"
  }
}
