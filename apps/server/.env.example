# Скопируй в apps/server/.env и подставь свои значения:
#   cp apps/server/.env.example apps/server/.env
# .env в git не попадает, .env.example — попадает. Все переменные валидируются
# Zod-схемой при старте (src/config/env.schema.ts): сервер не поднимется с плохим значением.

# development | production | test. В development Prisma логирует warn/error.
NODE_ENV=development

# Порт HTTP-сервера. Его же читает scripts/kill-port.mjs (хук predev),
# чтобы освободить порт после упавшего прогона.
PORT=4000

# Пул-соединение для приложения (Prisma + better-auth).
# Локально поднимается через `bun run dev:infra` (docker-compose.dev.yml).
DATABASE_URL=postgresql://vesper:vesper@localhost:5432/vesper

# Прямое соединение для миграций (prisma migrate/db push), в обход пулера.
# Локально совпадает с DATABASE_URL; в проде с PgBouncer/Neon — отличается.
DIRECT_URL=postgresql://vesper:vesper@localhost:5432/vesper

# Секрет подписи сессий better-auth. Минимум 32 символа.
# Для прода сгенерируй свой: `openssl rand -base64 32`. Никогда не переиспользуй dev-значение.
BETTER_AUTH_SECRET=dev-secret-change-me-min-32-chars-000

# Публичный адрес самого backend'а — better-auth строит по нему ссылки и куки.
BETTER_AUTH_URL=http://localhost:4000

# Origin'ы, которым разрешён CORS. Список через запятую, без пробелов.
# 3000 — Next.js dev-сервер; в Tauri-сборке фронт грузится с tauri://localhost.
CORS_ORIGINS=http://localhost:3000

# --- Ключи VPN-узлов ---
# В таблице node колонка wgEasyApiKeyRef хранит ИМЯ переменной окружения, а НЕ сам пароль.
# Т.е. если у узла wgEasyApiKeyRef='WG_KEY_DE', то здесь должна быть WG_KEY_DE=<пароль панели wg-easy>.
# Так пароли узлов не лежат в базе. Оркестратор читает их через process.env[ref];
# если переменной нет — connect вернёт NODE_UNAVAILABLE.
# Имена — на твой выбор, по одной строке на страну:
# WG_KEY_DE=пароль-панели-немецкого-узла
# WG_KEY_NL=пароль-панели-голландского-узла
