# Скопируй в apps/server/.env и подставь свои значения:
#   cp apps/server/.env.example apps/server/.env
# .env в git не попадает, .env.example — попадает. Все переменные валидируются
# Zod-схемой при старте (src/config/env.schema.ts): сервер не поднимется с плохим значением.

# development | production | test. В development Prisma логирует warn/error.
NODE_ENV=development

# Порт HTTP-сервера. Его же читает scripts/kill-port.mjs (хук predev),
# чтобы освободить порт после упавшего прогона.
PORT=4000

# Пул-соединение для приложения (Prisma + better-auth).
# Локально поднимается через `bun run dev:infra` (docker-compose.dev.yml).
# Порт 5433, а не 5432: 5432 часто занят нативной службой Postgres на хосте,
# и тогда подключение уходит мимо контейнера (ошибка P1000 при db push).
DATABASE_URL=postgresql://gnomevpn:gnomevpn@localhost:5433/gnomevpn

# Прямое соединение для миграций (prisma migrate/db push), в обход пулера.
# Локально совпадает с DATABASE_URL; в проде с PgBouncer/Neon — отличается.
DIRECT_URL=postgresql://gnomevpn:gnomevpn@localhost:5433/gnomevpn

# Секрет подписи сессий better-auth. Минимум 32 символа.
# Для прода сгенерируй свой: `openssl rand -base64 32`. Никогда не переиспользуй dev-значение.
BETTER_AUTH_SECRET=dev-secret-change-me-min-32-chars-000

# Публичный адрес самого backend'а — better-auth строит по нему ссылки и куки.
API_URL=http://localhost:4000

# Origin'ы, которым разрешён CORS. Список через запятую, без пробелов.
# 3000 — Next.js dev-сервер; в Tauri-сборке фронт грузится с tauri://localhost.
CORS_ORIGINS=http://localhost:3000

# --- ЮKassa ---
# Тестовый магазин: личный кабинет ЮKassa -> «Тестовый магазин».
# Без ключей сервер работает, но /billing/checkout вернёт ошибку.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда ЮKassa вернёт пользователя после оплаты в браузере.
YOOKASSA_RETURN_URL=http://localhost:3000/account
# То же для десктопа: оплата открывается во внешнем браузере, и вернуть человека
# в приложение можно только по deep link. Схему регистрирует сам установщик.
YOOKASSA_RETURN_URL_DESKTOP=gnomevpn://account
# Автосписания (рекуррентные платежи). ЮKassa подключает их вручную по заявке
# в поддержку — в личном кабинете такой настройки нет. Пока не подключены,
# save_payment_method отклоняется с ошибкой `forbidden`, и оплата не создаётся
# вообще. При false подписка оформляется разовым платежом, без автопродления.
YOOKASSA_RECURRING=false
# Цены и сроки тарифов живут в packages/schemas (PLANS), а не в переменных
# окружения: их читает и сервер при списании, и лендинг при отрисовке, поэтому
# разъехаться они не могут.

# Ключи VPN-узлов сюда не пишутся: `bun provision` кладёт их в .env.nodes
# рядом с этим файлом. Сервер читает оба.

# --- Почта (SMTP) ---
# Нужна для подтверждения адреса при регистрации, смены почты и сброса пароля.
# Пока переменные пустые, письма не отправляются: регистрация и вход работают,
# в лог пишется ошибка отправки. Подойдёт любой SMTP.
#
#   Timeweb:  SMTP_HOST=smtp.timeweb.ru   SMTP_PORT=465  SMTP_SECURE=true
#   Yandex:   SMTP_HOST=smtp.yandex.ru    SMTP_PORT=465  SMTP_SECURE=true
#   STARTTLS вместо TLS: SMTP_PORT=587  SMTP_SECURE=false
#
# Чтобы письма доходили, а не падали в спам:
#   - Адрес в EMAIL_FROM должен совпадать с SMTP_USER. Провайдеры отклоняют
#     чужой From: "Sender address rejected: not owned by auth user".
#     Имя отправителя перед <...> — любое, адрес внутри — строго SMTP_USER.
#   - Для домена нужны записи SPF, DKIM и DMARC (значения даёт почтовый
#     провайдер). Без них Gmail и mail.ru отправляют письма в спам.
#   - Домен отправителя должен совпадать с доменом ссылок в письме, поэтому
#     EMAIL_FROM, API_URL и CLIENT_URL держим на одном домене.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=GnomeVPN <noreply@gnomevpn.ru>

# Куда ведут ссылки из писем — адрес веб-клиента.
CLIENT_URL=http://localhost:3000

# Только для разработки: все письма уходят на этот адрес вместо реального,
# чтобы не писать живым пользователям. В продакшене игнорируется.
# DEV_EMAIL_OVERRIDE=you@example.com

# Токен с правами на чтение релизов приватного репозитория (classic PAT со
# scope `repo`, либо fine-grained с Contents: Read). Сервер ходит в GitHub от
# своего имени и отдаёт клиенту редирект на подписанную ссылку — сам токен
# наружу не уходит. Пустое значение = репозиторий публичный.
GITHUB_TOKEN=
