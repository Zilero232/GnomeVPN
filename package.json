{
  "name": "gnomevpn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '@gnomevpn/server' --filter '@gnomevpn/client' --parallel dev",
    "dev:server": "bun --filter @gnomevpn/server dev",
    "dev:client": "bun --filter @gnomevpn/client dev",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "tauri:dev": "bun --filter '@gnomevpn/server' --filter '@gnomevpn/tauri' --parallel dev",
    "tauri:build": "bun --filter @gnomevpn/client build && bun --filter @gnomevpn/tauri build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun --filter @gnomevpn/schemas typecheck && bun --filter @gnomevpn/server typecheck && bun --filter @gnomevpn/client typecheck",
    "lint:css": "stylelint \"apps/client/**/*.scss\"",
    "lint:css:fix": "stylelint \"apps/client/**/*.scss\" --fix",
    "provision:nodes": "bun --env-file apps/server/.env apps/server/scripts/provision-nodes.ts",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:major": "npm version major --no-git-tag-version",
    "prepare": "husky"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "node-ssh": "^13.2.1",
    "remeda": "^2.39.0",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bcryptjs": "^3.0.0",
    "fkill-cli": "^9.0.0",
    "husky": "^9.1.7",
    "kill-port": "^2.0.1",
    "lint-staged": "^17.1.0",
    "stylelint": "17.14.0",
    "stylelint-config-clean-order": "10.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-high-performance-animation": "2.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "~6.0.3",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "apps/client/**/*.scss": "stylelint --fix"
  }
}
