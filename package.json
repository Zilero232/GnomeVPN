{
  "name": "gnomevpn",
  "version": "1.0.0",
  "private": true,
  "description": "GnomeVPN — a commercial VPN on Hysteria2, delivered through the INCY client. Bun-workspaces monorepo.",
  "keywords": [
    "vpn",
    "hysteria2",
    "quic",
    "incy",
    "nextjs",
    "nestjs",
    "bun"
  ],
  "homepage": "https://gnome-vpn.com",
  "bugs": {
    "url": "https://github.com/Zilero232/GnomeVPN/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/GnomeVPN.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Alexandr Artemev",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.4.2",
      "@types/pg": "^8.23.1",
      "@types/react": "^19.3.0",
      "better-auth": "^1.7.5",
      "date-fns": "^4.4.0",
      "p-retry": "^8.0.1",
      "pg": "^8.23.0",
      "pino": "^10.3.1",
      "pino-pretty": "^13.1.3",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "remeda": "^2.50.0",
      "ts-pattern": "^5.9.0",
      "typescript": "~6.0.3",
      "zod": "^4.6.5"
    }
  },
  "scripts": {
    "prepare": "husky",
    "dev": "bun --filter '@gnomevpn/server' --filter '@gnomevpn/client' --parallel dev",
    "dev:server": "bun --filter @gnomevpn/server dev",
    "dev:client": "bun --filter @gnomevpn/client dev",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"apps/client/**/*.scss\"",
    "lint:css:fix": "stylelint \"apps/client/**/*.scss\" --fix",
    "typecheck": "bun --filter @gnomevpn/schemas typecheck && bun --filter @gnomevpn/scripts typecheck && bun --filter @gnomevpn/server typecheck && bun --filter @gnomevpn/client typecheck && tsc -p scripts --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run lint:css",
    "fix": "bun run lint:fix && bun run format && bun run lint:css:fix && bun run format:prisma",
    "provision:nodes": "bun --env-file .env --env-file .env.nodes scripts/provision/index.ts",
    "brand:icons": "bun scripts/brand-icons/index.ts",
    "format:prisma": "bun --filter @gnomevpn/server format:prisma",
    "secrets": "bun scripts/secrets/index.ts"
  },
  "dependencies": {
    "@gnomevpn/scripts": "workspace:*",
    "p-wait-for": "^6.0.0",
    "pg": "catalog:",
    "remeda": "^2.50.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@siberiacancode/eslint": "^2.18.1",
    "@siberiacancode/prettier": "^1.9.0",
    "@siberiacancode/stylelint": "^1.2.0",
    "@siberiacancode/tsconfig": "^1.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.11.0",
    "fkill-cli": "^9.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "stylelint": "17.15.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "catalog:",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write",
    "apps/client/**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
